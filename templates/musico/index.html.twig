{% extends 'base.html.twig' %}

{% block title %}Ver Músicos — Music Hub{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/perfil.css') }}">
{% endblock %}

{# ── Fondo líquido animado ── #}
{% block liquid_background %}
    <div id="perfil-background"></div>
    <script>
        (function () {
            var bg = document.getElementById('perfil-background');
            var colors = [
                'rgba(175, 79, 254, 0.7)',
                'rgba(0, 242, 255, 0.7)',
                'rgba(66,0,255,0.7)',
                'rgba(222, 106, 251, 0.7)',
                'rgba(0, 255, 136, 0.7)',
                'rgba(155,48,255,0.7)'
            ];
            function createBlob() {
                var blob = document.createElement('div');
                blob.classList.add('perfil-blob');
                var size = Math.random() * 300 + 150;
                blob.style.width = size + 'px';
                blob.style.height = size + 'px';
                blob.style.left = (Math.random() * 100) + '%';
                blob.style.top = (Math.random() * 100) + '%';
                blob.style.background = colors[Math.floor(Math.random() * colors.length)];
                bg.appendChild(blob);
                animateBlob(blob);
            }
            function animateBlob(blob) {
                var speed = Math.random() * 60 + 20;
                function move() {
                    var newSize = Math.random() * 300 + 150;
                    blob.style.transition =
                        'left ' + speed + 's ease-in-out, ' +
                        'top ' + speed + 's ease-in-out, ' +
                        'width ' + (speed / 2) + 's ease-in-out, ' +
                        'height ' + (speed / 2) + 's ease-in-out';
                    blob.style.left = (Math.random() * 100) + '%';
                    blob.style.top = (Math.random() * 100) + '%';
                    blob.style.width = newSize + 'px';
                    blob.style.height = newSize + 'px';
                    setTimeout(move, speed * 1000);
                }
                move();
            }
            for (var i = 0; i < 6; i++) createBlob();

            {# Solo en dispositivos no táctiles — en móvil no hay cursor #}
            if (!('ontouchstart' in window)) {
                document.addEventListener('mousemove', function (e) {
                    var mx = e.clientX / window.innerWidth;
                    var my = e.clientY / window.innerHeight;
                    bg.querySelectorAll('.perfil-blob').forEach(function (blob, i) {
                        var dir = (i % 2 === 0) ? 1 : -1;
                        blob.style.transform = 'translate(calc(-50% + ' + ((mx - 0.5) * 30 * dir) + 'px), calc(-50% + ' + ((my - 0.5) * 30 * dir) + 'px))';
                    });
                });
            }
        })();
    </script>
{% endblock %}

{% block body %}
<div class="musicos-wrapper">

    {# ── Cabecera ── #}
    <div class="musicos-header">
        <span class="musicos-header-bar"></span>
        <h1 class="musicos-titulo">MÚSICOS</h1>
    </div>

    {# ── Layout filtros + grid ── #}
    <div class="musicos-layout">

    {# ── Sidebar de filtros ── #}
    <aside class="musicos-filtros-sidebar">
        <p class="musicos-filtros-titulo">Filtros</p>

        <form method="get" action="{{ path('app_musico_index') }}">

            {# Géneros #}
            <div class="filtros-grupo">
                <p class="filtros-grupo-titulo">Género</p>
                <div class="filtros-grupo-scroll">
                    {% for genero in generos %}
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="filtros[generos][]"
                               id="f_genero_{{ genero.id }}"
                               value="{{ genero.id }}"
                               {% if genero.id in (filtros.generos ?? []) %}checked{% endif %}>
                        <label class="form-check-label" for="f_genero_{{ genero.id }}">{{ genero.nombre }}</label>
                    </div>
                    {% endfor %}
                </div>
            </div>

            {# Instrumentos #}
            <div class="filtros-grupo">
                <p class="filtros-grupo-titulo">Instrumento</p>
                <div class="filtros-grupo-scroll">
                    {% for instrumento in instrumentos %}
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="filtros[instrumentos][]"
                               id="f_inst_{{ instrumento.id }}"
                               value="{{ instrumento.id }}"
                               {% if instrumento.id in (filtros.instrumentos ?? []) %}checked{% endif %}>
                        <label class="form-check-label" for="f_inst_{{ instrumento.id }}">{{ instrumento.nombre }}</label>
                    </div>
                    {% endfor %}
                </div>
            </div>

            {# Ubicación #}
            <div class="filtros-grupo"
                 data-controller="google-places-autocomplete"
                 data-google-places-autocomplete-api-key-value="{{ google_places_api_key }}">
                <p class="filtros-grupo-titulo">Ubicación</p>
                <input class="filtros-ubicacion-input"
                       type="text"
                       placeholder="Ciudad o región..."
                       value="{{ filtros.ubicacion ?? '' }}">
                <button type="button" class="filtros-geolocate-btn" id="filtros-geolocate-btn">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="10" r="3"/>
                        <path d="M12 2a8 8 0 0 0-8 8c0 5 8 14 8 14s8-9 8-14a8 8 0 0 0-8-8z"/>
                    </svg>
                    Usar mi ubicación
                </button>
                <input type="hidden"
                       name="filtros[ubicacion]"
                       value="{{ filtros.ubicacion ?? '' }}">
                <input type="hidden"
                       name="filtros[lat]"
                       value="{{ filtros.lat ?? '' }}"
                       data-google-places-autocomplete-target="lat">
                <input type="hidden"
                       name="filtros[lng]"
                       value="{{ filtros.lng ?? '' }}"
                       data-google-places-autocomplete-target="lng">
                <div class="filtros-radio-wrap">
                    <div class="filtros-radio-header">
                        <span>Radio</span>
                        <span class="filtros-radio-valor" id="filtros-radio-valor">{{ filtros.radio ?? '20' }} km</span>
                    </div>
                    <input class="filtros-radio-slider"
                           type="range"
                           name="filtros[radio]"
                           id="filtros-radio"
                           min="10" max="100" step="10"
                           value="{{ filtros.radio ?? '20' }}">
                    <div class="filtros-radio-marks">
                        <span>10 km</span>
                        <span>100 km</span>
                    </div>
                </div>
            </div>

            <button type="submit" class="filtros-btn-aplicar">Aplicar filtros</button>
            <a href="{{ path('app_musico_index') }}" class="filtros-btn-limpiar">Limpiar</a>

        </form>
    </aside>

    {# ── Grid de tarjetas ── #}
    <div class="musicos-grid">
        {% for musico in musicos %}
        <div class="musico-card">

            {# Imagen #}
            <div class="musico-card-img">
                {% if musico.imagenUrl %}
                    <img src="{{ asset('uploads/perfiles/' ~ musico.imagenUrl) }}"
                         alt="{{ musico.nombre }}">
                {% else %}
                    <div class="musico-card-img-placeholder">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none"
                             stroke="#9b30ff" stroke-width="1.2">
                            <path d="M9 18V5l12-2v13"/>
                            <circle cx="6" cy="18" r="3"/>
                            <circle cx="18" cy="16" r="3"/>
                        </svg>
                    </div>
                {% endif %}
            </div>

            {# Info #}
            <div class="musico-card-info">
                <h2 class="musico-card-nombre">{{ musico.nombre }}</h2>

                <p class="musico-card-tags">
                    {% if musico.ubicacion %}
                        <span>{{ musico.ubicacion }}</span>
                    {% endif %}
                    {% if musico.anyosExperiencia is not null %}
                        <span>{{ musico.anyosExperiencia }} años exp.</span>
                    {% endif %}
                    {% if musico.id in distancias|keys %}
                        <span class="musico-card-distancia-tag">{{ distancias[musico.id] }} km</span>
                    {% endif %}
                </p>

                {# Instrumentos — máximo 3 #}
                {% if musico.instrumentos|length > 0 %}
                <div class="musico-card-instrumentos">
                    {% for instrumento in musico.instrumentos|slice(0, 3) %}
                        <span class="musico-card-instrumento-tag">{{ instrumento.nombre }}</span>
                    {% endfor %}
                    {% if musico.instrumentos|length > 3 %}
                        <span class="musico-card-instrumento-tag">+{{ musico.instrumentos|length - 3 }}</span>
                    {% endif %}
                </div>
                {% endif %}

                {# Géneros — máximo 3 #}
                {% if musico.generosMusicales|length > 0 %}
                <div class="musico-card-instrumentos">
                    {% for genero in musico.generosMusicales|slice(0, 3) %}
                        <span class="musico-card-instrumento-tag">{{ genero.nombre }}</span>
                    {% endfor %}
                    {% if musico.generosMusicales|length > 3 %}
                        <span class="musico-card-instrumento-tag">+{{ musico.generosMusicales|length - 3 }}</span>
                    {% endif %}
                </div>
                {% endif %}
            </div>

            {# Botones Ver perfil + Chat #}
            <div class="musico-card-footer">
                <a href="{{ path('app_musico_show', {'id': musico.id}) }}" class="btn-confirmar">Ver Perfil</a>
               <a href="#" class="btn-chat" title="Próximamente">Chat</a>
            </div>

        </div>
        {% else %}
        <p class="musicos-vacio">No hay músicos registrados todavía.</p>
        {% endfor %}
    </div>

    </div>{# fin musicos-layout #}

</div>

<script>
(function () {
    // ── Slider de radio ──
    var slider = document.getElementById('filtros-radio');
    var label  = document.getElementById('filtros-radio-valor');
    if (slider) {
        function updateSlider(v) {
            var pct = (v - 10) / 90 * 100;
            slider.style.background =
                'linear-gradient(to right,#9b30ff ' + pct + '%,rgba(155,48,255,0.18) ' + pct + '%)';
            label.textContent = v + ' km';
        }
        slider.addEventListener('input', function () { updateSlider(+this.value); });

        // ── Habilitar/deshabilitar según ubicación ──
        var ubicacionInput = document.querySelector('.filtros-ubicacion-input');
        if (ubicacionInput) {
            function syncSlider() {
                var hasLocation = ubicacionInput.value.trim() !== '';
                slider.disabled = !hasLocation;
                slider.closest('.filtros-radio-wrap').classList.toggle('filtros-radio-disabled', !hasLocation);
                if (!hasLocation) {
                    slider.style.background = 'rgba(155,48,255,0.18)';
                } else {
                    updateSlider(+slider.value);
                }
            }
            ubicacionInput.addEventListener('input', syncSlider);
            syncSlider();
        } else {
            updateSlider(+slider.value);
        }
    }

    // ── Botón "Usar mi ubicación" ──
    var btn = document.getElementById('filtros-geolocate-btn');
    if (!btn) return;
    if (!navigator.geolocation) { btn.style.display = 'none'; return; }

    btn.addEventListener('click', function () {
        btn.disabled = true;
        var originalHTML = btn.innerHTML;
        btn.textContent  = 'Obteniendo…';

        navigator.geolocation.getCurrentPosition(
            function (pos) {
                var lat = pos.coords.latitude;
                var lng = pos.coords.longitude;

                var latInput   = document.querySelector('[data-google-places-autocomplete-target="lat"]');
                var lngInput   = document.querySelector('[data-google-places-autocomplete-target="lng"]');
                var hiddenUbic = document.querySelector('[name="filtros[ubicacion]"]');
                var textInput  = document.querySelector('.filtros-ubicacion-input');

                if (latInput)  latInput.value = lat;
                if (lngInput)  lngInput.value = lng;

                function setLabel(label) {
                    if (textInput) {
                        textInput.value = label;
                        textInput.dispatchEvent(new Event('input'));
                    }
                    if (hiddenUbic) hiddenUbic.value = label;
                    btn.disabled  = false;
                    btn.innerHTML = originalHTML;
                }

                if (window.google && window.google.maps) {
                    new google.maps.Geocoder().geocode(
                        { location: { lat: lat, lng: lng } },
                        function (results, status) {
                            if (status === 'OK' && results[0]) {
                                var comps   = results[0].address_components;
                                var city    = comps.find(function (c) { return c.types.includes('locality'); }) ||
                                              comps.find(function (c) { return c.types.includes('administrative_area_level_2'); }) ||
                                              comps.find(function (c) { return c.types.includes('administrative_area_level_1'); });
                                var country = comps.find(function (c) { return c.types.includes('country'); });
                                setLabel(city && country
                                    ? city.long_name + ', ' + country.long_name
                                    : results[0].formatted_address);
                            } else {
                                setLabel(lat.toFixed(4) + ', ' + lng.toFixed(4));
                            }
                        }
                    );
                } else {
                    setLabel(lat.toFixed(4) + ', ' + lng.toFixed(4));
                }
            },
            function () {
                btn.disabled  = false;
                btn.innerHTML = originalHTML;
            }
        );
    });
})();
</script>
{% endblock %}
