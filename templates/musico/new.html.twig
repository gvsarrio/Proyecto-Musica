{% extends 'base.html.twig' %}

{% block title %}Crear Perfil Músico
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/perfil.css') }}">
{% endblock %}


{# Fondo líquido animado #}
{% block liquid_background %}
	<div id="perfil-background"></div>
	<script>
		(function () {
			var bg = document.getElementById('perfil-background');
			var colors = [
				'rgba(155, 48, 255, 0.85)',
				'rgba(255, 0, 255, 0.75)',
				'rgba(0, 212, 255, 0.85)',
				'rgba(100, 0, 255, 0.8)',
				'rgba(217, 102, 255, 0.75)',
				'rgba(0, 255, 200, 0.7)'
			];

		function createBlob() {
			var blob = document.createElement('div');
			blob.classList.add('perfil-blob');
			var size = Math.random() * 300 + 150;
			blob.style.width = size + 'px';
			blob.style.height = size + 'px';
			blob.style.left = (Math.random() * 100) + '%';
			blob.style.top = (Math.random() * 100) + '%';
			blob.style.background = colors[Math.floor(Math.random() * colors.length)];
			bg.appendChild(blob);
			animateBlob(blob);
		}

		function animateBlob(blob) {
			var speed = Math.random() * 60 + 20;
		function move() {
			var newSize = Math.random() * 300 + 150;
			blob.style.transition = 'left ' + speed + 's ease-in-out, ' + 'top ' + speed + 's ease-in-out, ' + 'width ' + (
			speed / 2
			) + 's ease-in-out, ' + 'height ' + (
			speed / 2
			) + 's ease-in-out';
			blob.style.left = (Math.random() * 100) + '%';
			blob.style.top = (Math.random() * 100) + '%';
			blob.style.width = newSize + 'px';
			blob.style.height = newSize + 'px';
			setTimeout(move, speed * 1000);
			}
			move();
		}

		for (var i = 0; i < 6; i++) createBlob();

		{# Solo en dispositivos no táctiles — en móvil no hay cursor #}
		if (!('ontouchstart' in window)) {
			document.addEventListener('mousemove', function(e) {
				var mx = e.clientX / window.innerWidth;
				var my = e.clientY / window.innerHeight;
				var blobs = bg.querySelectorAll('.perfil-blob');
				blobs.forEach(function(blob, i) {
					var dir = (i % 2 === 0) ? 1 : -1;
					var ox = (mx - 0.5) * 30 * dir;
					var oy = (my - 0.5) * 30 * dir;
					blob.style.transform = 'translate(calc(-50% + ' + ox + 'px), calc(-50% + ' + oy + 'px))';
				});
			});
		}
	})();
</script>
{% endblock %}


{% block body %}
	<div class="perfil-wrapper">
		<div class="perfil-card">
			<div class="perfil-accent-bar"></div>

			{# Mensajes de éxito #}
			{% for message in app.flashes('success') %}
				<div class="alert-perfil-success">✓
					{{ message }}</div>
			{% endfor %}

			{# Avatar / Icono decorativo #}
			<div class="perfil-avatar-wrap">
				<div class="perfil-avatar">
					<svg width="45" height="45" viewbox="0 0 24 24" fill="none" stroke="#00b4ff" stroke-width="1.5">
						<path d="M9 18V5l12-2v13"/>
						<circle cx="6" cy="18" r="3"/>
						<circle cx="18" cy="16" r="3"/>
					</svg>
				</div>
			</div>

			<h1 class="perfil-title">Crear perfil</h1>
			<p class="perfil-subtitle">Cuéntanos sobre ti para conectar con otros músicos</p>
			<hr class="perfil-divider">

			{# IMPORTANTE: enctype para permitir la subida de la foto #}
			{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}

			<div class="row g-3">
				<div class="col-12">
					{{ form_label(form.nombre, 'Nombre artístico: ') }}
					{{ form_widget(form.nombre, {'attr': {'class': 'form-control', 'placeholder': 'Ej: Sharknado'}}) }}
					{{ form_errors(form.nombre) }}
				</div>

				<div class="col-md-6">
					{{ form_label(form.telefono, 'Teléfono de contacto: ') }}
					{{ form_widget(form.telefono, {'attr': {'class': 'form-control', 'placeholder': 'Ej: 612 345 678'}}) }}
					{{ form_errors(form.telefono) }}
				</div>

				<div class="col-md-6">
					{{ form_label(form.anyos_experiencia, 'Años de experiencia: ') }}
					{{ form_widget(form.anyos_experiencia, {'attr': {'class': 'form-control', 'placeholder': 'Ej: 5'}}) }}
					{{ form_errors(form.anyos_experiencia) }}
				</div>

				{# SECCIÓN DE INSTRUMENTOS (Checkboxes) #}
				<div class="col-12">
					{{ form_label(form.instrumentos_sistema, '¿Qué instrumentos tocas?') }}
					<div class="perfil-instrumentos-container">
						{{ form_widget(form.instrumentos_sistema) }}
						{{ form_widget(form.instrumentos_personalizados) }}
					</div>
					<small style="color: var(--mh-text-muted);">Selecciona todos los que apliquen</small>
					{{ form_errors(form.instrumentos_sistema) }}
					{{ form_errors(form.instrumentos_personalizados) }}
					<div class="instrumento-add-wrap">
						{{ form_widget(form.instrumentos_nuevos, {'attr': {'class': 'instrumento-add-input', 'placeholder': 'Ej: Ukelele...'}}) }}
						<button id="btn-add-instrument" class="btn-confirmar" type="button">Añadir Instrumento</button>
					</div>
					<small style="color: var(--mh-text-muted);">
						¿No encuentras tu instrumento? Escríbelo y pulsa Añadir Instrumento. Se añadirá al listado global.
					</small>
					<input type="hidden" id="csrf_add_instrument" value="{{ csrf_token('add_instrument') }}">
				</div>

				{# SECCIÓN DE GÉNEROS MUSICALES (Checkboxes) #}
				<div class="col-12">
					{{ form_label(form.generos_musicales, '¿Qué géneros musicales tocas?') }}
					<div class="perfil-instrumentos-container">
						{{ form_widget(form.generos_musicales) }}
					</div>
					<small style="color: var(--mh-text-muted);">Selecciona todos los que apliquen</small>
					{{ form_errors(form.generos_musicales) }}
				</div>

				<div class="col-12"
					data-controller="google-places-autocomplete"
					data-google-places-autocomplete-api-key-value="{{ google_places_api_key }}">
					{{ form_label(form.ubicacion, 'Ubicación') }}
					{{ form_widget(form.ubicacion, {'attr': {'class': 'form-control', 'placeholder': 'Ej: Murcia, España'}}) }}
					{{ form_errors(form.ubicacion) }}
					{{ form_widget(form.latitud, {'attr': {'data-google-places-autocomplete-target': 'lat'}}) }}
					{{ form_widget(form.longitud, {'attr': {'data-google-places-autocomplete-target': 'lng'}}) }}
				</div>

				<div class="col-12">
					{{ form_label(form.biografia, 'Tu biografía: ') }}
					{{ form_widget(form.biografia, {'attr': {'class': 'form-control', 'rows': '4', 'placeholder': 'Cuéntanos sobre tu estilo, influencias...'}}) }}
					{{ form_errors(form.biografia) }}
				</div>

				{# SUBIDA DE IMAGEN #}
				<div class="col-12">
					{{ form_label(form.imagen_url, 'Foto de perfil: ') }}
					{{ form_widget(form.imagen_url, {'attr': {'class': 'form-control'}}) }}
					<small style="color: var(--mh-text-muted);">Formatos permitidos: JPG, PNG o WEBP (Máx. 2MB)</small>
					{{ form_errors(form.imagen_url) }}
				</div>
			</div>

			<div class="d-flex justify-content-center mt-4">
				<button type="submit" class="btn-principal">Crear Perfil</button>
			</div>

			{{ form_end(form) }}

		</div>
	</div>

	<script>
	{# Función reutilizable para mostrar errores estilizados en vez de alert() nativo #}
	function mostrarError(mensaje) {
		var existing = document.getElementById('instrumento-error-msg');
		if (existing) existing.remove();
		var err = document.createElement('div');
		err.id = 'instrumento-error-msg';
		err.className = 'alert-perfil-error';
		err.textContent = mensaje;
		var wrap = document.querySelector('.instrumento-add-wrap');
		wrap.parentNode.insertBefore(err, wrap);
		setTimeout(function() { err.remove(); }, 4000);
	}

	document.getElementById('btn-add-instrument').addEventListener('click', function() {
		var nombre = document.getElementById('{{ form.instrumentos_nuevos.vars.id }}').value.trim();
		if (!nombre) return mostrarError('Introduce el nombre del instrumento');
		var token = document.getElementById('csrf_add_instrument').value;
		var formData = new FormData();
		formData.append('nombre', nombre);
		formData.append('_token', token);
		fetch('{{ path('app_instrumento_add') }}', {
			method: 'POST',
			body: formData,
			headers: { 'X-Requested-With': 'XMLHttpRequest' }
		}).then(resp => resp.json()).then(data => {
			if (data.error) return mostrarError(data.error);
			var container = document.querySelector('.perfil-instrumentos-container');
			if (!container) return;
			var id = 'musico_instrumentos_' + data.id;
			var wrapper = document.createElement('div'); wrapper.className = 'form-check';
			var input = document.createElement('input');
			input.type = 'checkbox'; input.className = 'form-check-input'; input.name = '{{ form.instrumentos_personalizados.vars.full_name }}[]';
			input.id = id; input.value = data.id; input.checked = true;
			var label = document.createElement('label'); label.className = 'form-check-label'; label.htmlFor = id; label.textContent = data.nombre;
			wrapper.appendChild(input); wrapper.appendChild(label);
			container.appendChild(wrapper);
			document.getElementById('{{ form.instrumentos_nuevos.vars.id }}').value = '';
			var msg = document.createElement('div');
			msg.className = 'instrumento-add';
			msg.textContent = '✓ Instrumento "' + data.nombre + '" añadido correctamente';
			var wrap = document.querySelector('.instrumento-add-wrap');
			wrap.parentNode.insertBefore(msg, wrap.nextSibling);
			setTimeout(function() { msg.style.opacity = '0'; }, 2000);
			setTimeout(function() { msg.remove(); }, 3000);
		}).catch(err => { console.error(err); mostrarError('Error añadiendo instrumento'); });
	});
	</script>
{% endblock %}
