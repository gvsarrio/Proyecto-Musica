{% extends 'base.html.twig' %}

{% block title %}Perfil de {{ musico.nombre }}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/perfil.css') }}">
{% endblock %}

{# Fondo líquido animado #}
{% block liquid_background %}
	<div id="perfil-background"></div>
	<script>
		(function () {
			var bg = document.getElementById('perfil-background');
			var colors = [
				'rgba(155, 48, 255, 0.85)',
				'rgba(255, 0, 255, 0.75)',
				'rgba(0, 212, 255, 0.85)',
				'rgba(100, 0, 255, 0.8)',
				'rgba(217, 102, 255, 0.75)',
				'rgba(0, 255, 200, 0.7)'
			];

		function createBlob() {
			var blob = document.createElement('div');
			blob.classList.add('perfil-blob');
			var size = Math.random() * 300 + 150;
			blob.style.width = size + 'px';
			blob.style.height = size + 'px';
			blob.style.left = (Math.random() * 100) + '%';
			blob.style.top = (Math.random() * 100) + '%';
			blob.style.background = colors[Math.floor(Math.random() * colors.length)];
			bg.appendChild(blob);
			animateBlob(blob);
		}

		function animateBlob(blob) {
			var speed = Math.random() * 60 + 20;
		function move() {
			var newSize = Math.random() * 300 + 150;
			blob.style.transition = 'left ' + speed + 's ease-in-out, ' + 'top ' + speed + 's ease-in-out, ' + 'width ' + (
			speed / 2
			) + 's ease-in-out, ' + 'height ' + (
			speed / 2
			) + 's ease-in-out';
			blob.style.left = (Math.random() * 100) + '%';
			blob.style.top = (Math.random() * 100) + '%';
			blob.style.width = newSize + 'px';
			blob.style.height = newSize + 'px';
			setTimeout(move, speed * 1000);
			}
			move();
		}

		for (var i = 0; i < 6; i++) createBlob();

		{# Solo en dispositivos no táctiles — en móvil no hay cursor #}
		if (!('ontouchstart' in window)) {
			document.addEventListener('mousemove', function(e) {
				var mx = e.clientX / window.innerWidth;
				var my = e.clientY / window.innerHeight;
				var blobs = bg.querySelectorAll('.perfil-blob');
				blobs.forEach(function(blob, i) {
					var dir = (i % 2 === 0) ? 1 : -1;
					var ox = (mx - 0.5) * 30 * dir;
					var oy = (my - 0.5) * 30 * dir;
					blob.style.transform = 'translate(calc(-50% + ' + ox + 'px), calc(-50% + ' + oy + 'px))';
				});
			});
		}
	})();
</script>
{% endblock %}


{% block body %}
	<div class="perfil-wrapper">
		<div class="perfil-card">
			<div class="perfil-accent-bar"></div>

			{# Avatar con imagen de perfil #}
			<div class="perfil-avatar-wrap">
				<div class="perfil-avatar">
					{% if musico.imagenUrl %}
						<img src="{{ asset('uploads/perfiles/' ~ musico.imagenUrl) }}" alt="Foto de {{ musico.nombre }}">
					{% else %}
						<svg width="45" height="45" viewBox="0 0 24 24" fill="none" stroke="#00b4ff" stroke-width="1.5">
							<path d="M9 18V5l12-2v13"/>
							<circle cx="6" cy="18" r="3"/>
							<circle cx="18" cy="16" r="3"/>
						</svg>
					{% endif %}
				</div>
			</div>

			<h1 class="perfil-title">{{ musico.nombre }}</h1>
			<p class="perfil-subtitle">
				{% if musico.ubicacion %}{{ musico.ubicacion }}{% else %}Músico apasionado{% endif %}
			</p>
			<hr class="perfil-divider">

			<div class="row g-4">

				{% if musico.biografia %}
				<div class="col-12">
					<p class="perfil-form-label">Biografía:</p>
					<p class="show-dato-valor">{{ musico.biografia }}</p>
				</div>
				{% endif %}

				<div class="col-md-6">
					{% if musico.telefono %}
					<p class="perfil-form-label">Teléfono:</p>
					<p class="show-dato-valor">{{ musico.telefono }}</p>
					{% endif %}
				</div>

				<div class="col-md-6">
					{% if musico.anyosExperiencia is not null %}
					<p class="perfil-form-label">Años de experiencia:</p>
					<p class="show-dato-valor">{{ musico.anyosExperiencia }} años</p>
					{% endif %}
				</div>

				{% if musico.ubicacion %}
				<div class="col-12">
					<p class="perfil-form-label">Ubicación:</p>
					<p class="show-dato-valor">{{ musico.ubicacion }}</p>
				</div>
				{% endif %}

				{% if musico.instrumentos|length > 0 %}
				<div class="col-12">
					<p class="perfil-form-label">Instrumentos:</p>
					<div class="musico-card-instrumentos">
						{% for instrumento in musico.instrumentos %}
							<span class="musico-card-instrumento-tag">{{ instrumento.nombre }}</span>
						{% endfor %}
					</div>
				</div>
				{% endif %}

				{% if musico.generosMusicales|length > 0 %}
				<div class="col-12">
					<p class="perfil-form-label">Géneros:</p>
					<div class="musico-card-instrumentos">
						{% for genero in musico.generosMusicales %}
							<span class="musico-card-instrumento-tag">{{ genero.nombre }}</span>
						{% endfor %}
					</div>
				</div>
				{% endif %}

				{% if musico.miembroBandasAceptadas|length > 0 %}
				<div class="col-12">
					<p class="perfil-form-label">Bandas:</p>
					<div class="musico-card-instrumentos">
						{% for mb in musico.miembroBandasAceptadas %}
							<a href="{{ path('app_banda_show', {id: mb.banda.id}) }}" class="musico-card-instrumento-tag">
								{{ mb.banda.nombre }}{% if mb.esAdministrador %} ★{% endif %}
							</a>
						{% endfor %}
					</div>
				</div>
				{% endif %}

			</div>

			{# ── Invitaciones pendientes (solo para el propio músico) ── #}
			{% if invitaciones|length > 0 %}
			<hr class="perfil-divider">
			<div class="row g-2 mb-2">
				<div class="col-12">
					<p class="gestionar-seccion-label">Invitaciones pendientes</p>
					{% for inv in invitaciones %}
					<div class="gestionar-fila">
						<a href="{{ path('app_banda_show', {id: inv.banda.id}) }}" class="gestionar-fila-nombre mh-text-verde">
							{{ inv.banda.nombre }}
						</a>
						<div class="gestionar-fila-acciones">
							<form method="post" action="{{ path('app_banda_aceptar_invitacion', {id: inv.id}) }}">
								<input type="hidden" name="_token" value="{{ csrf_token('aceptar_invitacion_' ~ inv.id) }}">
								<button type="submit" class="btn-confirmar btn-sm">Aceptar</button>
							</form>
							<form method="post" action="{{ path('app_banda_rechazar_invitacion', {id: inv.id}) }}">
								<input type="hidden" name="_token" value="{{ csrf_token('rechazar_invitacion_' ~ inv.id) }}">
								<button type="submit" class="btn-eliminar btn-sm">Rechazar</button>
							</form>
						</div>
					</div>
					{% endfor %}
				</div>
			</div>
			{% endif %}

			<div class="d-flex justify-content-center gap-2 mt-4 flex-wrap">
				{# Solo se muestra el botón para EDITAR cuando el perfil es del propio usuario logueado #}
				{% if app.user == musico.usuario %}
					<a href="{{ path('app_musico_edit', {'id': musico.id}) }}" class="btn-editar">Editar</a>
				{% elseif app.user and app.user.musico is not null %}
					<a href="{{ path('mensaje_nuevo', {'id': musico.usuario.id}) }}" class="btn-confirmar">Chat</a>
				{% endif %}

				{# Botones de invitar a banda (visible para admins viendo el perfil de otro músico) #}
				{% for banda in bandas_para_invitar %}
					<form method="post" action="{{ path('app_banda_invitar', {banda: banda.id, musico: musico.id}) }}">
						<input type="hidden" name="_token" value="{{ csrf_token('invitar_' ~ banda.id ~ '_' ~ musico.id) }}">
						<button type="submit" class="btn-editar">
							Invitar a {{ banda.nombre }}
						</button>
					</form>
				{% endfor %}

				<a href="{{ path('app_musico_index') }}" class="btn-confirmar">Músicos</a>
			</div>

			{# Solo se muestra el botón para BORRAR cuando el perfil es del propio usuario logueado #}
			{% if app.user == musico.usuario %}
				<div class="mt-3 text-center">
					{{ include('musico/_delete_form.html.twig') }}
				</div>
			{% endif %}

		</div>
	</div>
{% endblock %}
