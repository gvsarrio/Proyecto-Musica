{% extends 'base.html.twig' %}

{% block title %}Perfil de {{ musico.nombre }}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/perfil.css') }}">
{% endblock %}

{# Fondo líquido animado #}
{% block liquid_background %}
	<div id="perfil-background"></div>
	<script>
		(function () {
			var bg = document.getElementById('perfil-background');
			var colors = [
				'rgba(175, 79, 254, 0.7)',
				'rgba(0, 242, 255, 0.7)',
				'rgba(66,0,255,0.7)',
				'rgba(222, 106, 251, 0.7)',
				'rgba(0, 255, 136, 0.7)',
				'rgba(155,48,255,0.7)'
			];

		function createBlob() {
			var blob = document.createElement('div');
			blob.classList.add('perfil-blob');
			var size = Math.random() * 300 + 150;
			blob.style.width = size + 'px';
			blob.style.height = size + 'px';
			blob.style.left = (Math.random() * 100) + '%';
			blob.style.top = (Math.random() * 100) + '%';
			blob.style.background = colors[Math.floor(Math.random() * colors.length)];
			bg.appendChild(blob);
			animateBlob(blob);
		}

		function animateBlob(blob) {
			var speed = Math.random() * 60 + 20;
		function move() {
			var newSize = Math.random() * 300 + 150;
			blob.style.transition = 'left ' + speed + 's ease-in-out, ' + 'top ' + speed + 's ease-in-out, ' + 'width ' + (
			speed / 2
			) + 's ease-in-out, ' + 'height ' + (
			speed / 2
			) + 's ease-in-out';
			blob.style.left = (Math.random() * 100) + '%';
			blob.style.top = (Math.random() * 100) + '%';
			blob.style.width = newSize + 'px';
			blob.style.height = newSize + 'px';
			setTimeout(move, speed * 1000);
			}
			move();
		}

		for (var i = 0; i < 6; i++) createBlob();

		document.addEventListener('mousemove', function(e) {
			var mx = e.clientX / window.innerWidth;
			var my = e.clientY / window.innerHeight;
			var blobs = bg.querySelectorAll('.perfil-blob');
			blobs.forEach(function(blob, i) {
				var dir = (i % 2 === 0) ? 1 : -1;
				var ox = (mx - 0.5) * 30 * dir;
				var oy = (my - 0.5) * 30 * dir;
				blob.style.transform = 'translate(calc(-50% + ' + ox + 'px), calc(-50% + ' + oy + 'px))';
			});
		});
	})();
</script>
{% endblock %}


{% block body %}
	<div class="perfil-wrapper">
		<div class="perfil-card">
			<div class="perfil-accent-bar"></div>

			{# Avatar con imagen de perfil #}
			<div class="perfil-avatar-wrap">
				<div class="perfil-avatar">
					{% if musico.imagenUrl %}
						<img src="{{ asset('uploads/perfiles/' ~ musico.imagenUrl) }}" alt="Foto de {{ musico.nombre }}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
					{% else %}
						<svg width="45" height="45" viewBox="0 0 24 24" fill="none" stroke="#00b4ff" stroke-width="1.5">
							<path d="M9 18V5l12-2v13"/>
							<circle cx="6" cy="18" r="3"/>
							<circle cx="18" cy="16" r="3"/>
						</svg>
					{% endif %}
				</div>
			</div>

			<h1 class="perfil-title">{{ musico.nombre }}</h1>
			<p class="perfil-subtitle">
				{% if musico.ubicacion %}{{ musico.ubicacion }}{% else %}Músico apasionado{% endif %}
			</p>
			<hr class="perfil-divider">

			<div class="row g-4">

				{% if musico.biografia %}
				<div class="col-12">
					<p class="show-dato-label" style="font-family: var(--font-body); font-size: 11px; font-weight: 700; color: var(--mh-purple-light); text-transform: uppercase; letter-spacing: 2px; margin: 0 0 4px;">Biografía:</p>
					<p style="font-family: var(--font-body); font-size: 14px; color: #e8e0ff; margin: 0;">{{ musico.biografia }}</p>
				</div>
				{% endif %}

				<div class="col-md-6">
					{% if musico.telefono %}
					<p class="show-dato-label" style="font-family: var(--font-body); font-size: 11px; font-weight: 700; color: var(--mh-purple-light); text-transform: uppercase; letter-spacing: 2px; margin: 0 0 4px;">Teléfono:</p>
					<p style="font-family: var(--font-body); font-size: 14px; color: #e8e0ff; margin: 0;">{{ musico.telefono }}</p>
					{% endif %}
				</div>

				<div class="col-md-6">
					{% if musico.anyosExperiencia is not null %}
					<p class="show-dato-label" style="font-family: var(--font-body); font-size: 11px; font-weight: 700; color: var(--mh-purple-light); text-transform: uppercase; letter-spacing: 2px; margin: 0 0 4px;">Años de experiencia:</p>
					<p style="font-family: var(--font-body); font-size: 14px; color: #e8e0ff; margin: 0;">{{ musico.anyosExperiencia }} años</p>
					{% endif %}
				</div>

				{% if musico.ubicacion %}
				<div class="col-12">
					<p class="show-dato-label" style="font-family: var(--font-body); font-size: 11px; font-weight: 700; color: var(--mh-purple-light); text-transform: uppercase; letter-spacing: 2px; margin: 0 0 4px;">Ubicación:</p>
					<p style="font-family: var(--font-body); font-size: 14px; color: #e8e0ff; margin: 0;">{{ musico.ubicacion }}</p>
				</div>
				{% endif %}

				{% if musico.instrumentos|length > 0 %}
				<div class="col-12">
					<p class="show-dato-label" style="font-family: var(--font-body); font-size: 11px; font-weight: 700; color: var(--mh-purple-light); text-transform: uppercase; letter-spacing: 2px; margin: 0 0 8px;">Instrumentos:</p>
					<div class="musico-card-instrumentos">
						{% for instrumento in musico.instrumentos %}
							<span class="musico-card-instrumento-tag">{{ instrumento.nombre }}</span>
						{% endfor %}
					</div>
				</div>
				{% endif %}

				{% if musico.miembroBandasAceptadas|length > 0 %}
				<div class="col-12">
					<p class="show-dato-label" style="font-family: var(--font-body); font-size: 11px; font-weight: 700; color: var(--mh-purple-light); text-transform: uppercase; letter-spacing: 2px; margin: 0 0 8px;">Bandas:</p>
					<div class="musico-card-instrumentos">
						{% for mb in musico.miembroBandasAceptadas %}
							<a href="{{ path('app_banda_show', {id: mb.banda.id}) }}" class="musico-card-instrumento-tag" style="text-decoration: none;">
								{{ mb.banda.nombre }}{% if mb.esAdministrador %} ★{% endif %}
							</a>
						{% endfor %}
					</div>
				</div>
				{% endif %}

			</div>

			{# ── Invitaciones pendientes (solo para el propio músico) ── #}
			{% if invitaciones|length > 0 %}
			<hr class="perfil-divider">
			<div class="row g-2 mb-2">
				<div class="col-12">
					<p style="font-size: 11px; font-weight: 700; color: var(--mh-purple-light); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 12px;">Invitaciones pendientes</p>
					{% for inv in invitaciones %}
					<div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.8rem 1rem; background: rgba(255,255,255,0.04); border-radius: 8px; border: 1px solid rgba(255,255,255,0.08); margin-bottom: 8px;">
						<a href="{{ path('app_banda_show', {id: inv.banda.id}) }}" style="color: var(--mh-purple-light); font-weight: 600; text-decoration: none;">
							{{ inv.banda.nombre }}
						</a>
						<div style="display: flex; gap: 0.5rem;">
							<form method="post" action="{{ path('app_banda_aceptar_invitacion', {id: inv.id}) }}">
								<input type="hidden" name="_token" value="{{ csrf_token('aceptar_invitacion_' ~ inv.id) }}">
								<button type="submit" class="btn-confirmar" style="padding: 0.3rem 1rem; font-size: 13px;">Aceptar</button>
							</form>
							<form method="post" action="{{ path('app_banda_rechazar_invitacion', {id: inv.id}) }}">
								<input type="hidden" name="_token" value="{{ csrf_token('rechazar_invitacion_' ~ inv.id) }}">
								<button type="submit" class="btn-editar" style="padding: 0.3rem 1rem; font-size: 13px;">Rechazar</button>
							</form>
						</div>
					</div>
					{% endfor %}
				</div>
			</div>
			{% endif %}

			<div class="d-flex justify-content-center gap-2 mt-4 flex-wrap">
				{# Solo se muestra el botón para EDITAR cuando el perfil es del propio usuario logueado #}
				{% if app.user == musico.usuario %}
					<a href="{{ path('app_musico_edit', {'id': musico.id}) }}" class="btn-editar">Editar Perfil</a>
				{% endif %}

				{# Botones de invitar a banda (visible para admins viendo el perfil de otro músico) #}
				{% for banda in bandas_para_invitar %}
					<form method="post" action="{{ path('app_banda_invitar', {banda: banda.id, musico: musico.id}) }}">
						<input type="hidden" name="_token" value="{{ csrf_token('invitar_' ~ banda.id ~ '_' ~ musico.id) }}">
						<button type="submit" class="btn-confirmar" style="font-size: 13px;">
							Invitar a {{ banda.nombre }}
						</button>
					</form>
				{% endfor %}

				<a href="{{ path('app_musico_index') }}" class="btn-confirmar">Ver Músicos</a>
			</div>

			{# Solo se muestra el botón para BORRAR cuando el perfil es del propio usuario logueado #}
			{% if app.user == musico.usuario %}
				<div class="mt-3 text-center">
					{{ include('musico/_delete_form.html.twig') }}
				</div>
			{% endif %}

		</div>
	</div>
{% endblock %}
