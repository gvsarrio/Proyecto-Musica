{# Ventana de confirmación — Eliminar perfil de músico #}
<div id="modal-eliminar-musico" class="mh-modal-overlay" style="display:none;">
    <div class="mh-modal-card">
        <div class="mh-modal-accent-bar"></div>
        <p class="mh-modal-titulo">¿Eliminar perfil?</p>
        <p class="mh-modal-texto">Esta acción es irreversible. Tu perfil de músico será eliminado permanentemente.</p>
        <div class="mh-modal-acciones">
            <button type="button" class="btn-eliminar" onclick="document.getElementById('form-eliminar-musico').submit()">Eliminar Perfil</button>
            <button type="button" class="btn-principal" onclick="document.getElementById('modal-eliminar-musico').style.display='none'">Cancelar</button>
        </div>
    </div>
</div>

<form id="form-eliminar-musico" method="post" action="{{ path('app_musico_delete', {'id': musico.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ musico.id) }}">
    <button type="button" class="btn-eliminar" onclick="document.getElementById('modal-eliminar-musico').style.display='flex'">
        Eliminar
    </button>
</form>
