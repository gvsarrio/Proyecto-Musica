{% extends 'base.html.twig' %}
{% block title %}Crear cuenta — MusicHub{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('css/perfil.css') }}">
{% endblock %}
{% block liquid_background %}
<div id="auth-background"></div>
<script>
(function() {
    var bg = document.getElementById('auth-background');
    var colors = ['rgba(12,255,220,0.7)', 'rgba(255,0,255,0.7)', 'rgba(66,0,255,0.7)', 'rgba(155,48,255,0.7)'];
    var blobs = [];
    for (var i = 0; i < 4; i++) {
        var blob = document.createElement('div');
        blob.classList.add('auth-blob');
        var size = Math.random() * 250 + 200;
        blob.style.width  = size + 'px';
        blob.style.height = size + 'px';
        blob.style.left   = (Math.random() * 100) + '%';
        blob.style.top    = (Math.random() * 100) + '%';
        blob.style.background = colors[Math.floor(Math.random() * colors.length)];
        bg.appendChild(blob);
        blobs.push(blob);
    }
    function animateBlobs() {
        blobs.forEach(function(blob) {
            blob.style.left = (Math.random() * 100) + '%';
            blob.style.top  = (Math.random() * 100) + '%';
        });
    }
    setTimeout(animateBlobs, 100);
    setInterval(animateBlobs, 6000);

    {# Solo en dispositivos no táctiles — en móvil no hay cursor #}
    if (!('ontouchstart' in window)) {
        document.addEventListener('mousemove', function(e) {
            var mx = e.clientX / window.innerWidth;
            var my = e.clientY / window.innerHeight;
            blobs.forEach(function(blob, i) {
                var dir = (i % 2 === 0) ? 1 : -1;
                var ox = (mx - 0.5) * 30 * dir;
                var oy = (my - 0.5) * 30 * dir;
                blob.style.transform = 'translate(calc(-50% + ' + ox + 'px), calc(-50% + ' + oy + 'px))';
            });
        });
    }
})();
</script>
{% endblock %}
{% block body %}
<div class="auth-wrapper">
    <div class="auth-card-container">
        <div class="auth-card-header-accent-bar"></div>
        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="auth-error-alert" role="alert">{{ flash_error }}</div>
        {% endfor %}
        <h1>Regístrate en <span class="auth-card-brand" data-text="Music Hub">Music Hub</span></h1>
        <hr class="auth-form-divider">
        {{ form_errors(registrationForm) }}
        {{ form_start(registrationForm) }}
            {{ form_row(registrationForm.email, {
            label_attr: { class: 'auth-form-label' },
            attr: { placeholder: 'usuario@ejemplo.com' }
            }) }}
            {{ form_row(registrationForm.plainPassword, {
                label: 'Contraseña',
                label_attr: { class: 'auth-form-label' },
                attr: { placeholder: '••••••••' }
            }) }}
            <div class="form-check">
                <input type="checkbox"
                    id="{{ registrationForm.agreeTerms.vars.id }}"
                    name="{{ registrationForm.agreeTerms.vars.full_name }}"
                    value="{{ registrationForm.agreeTerms.vars.value }}"
                    class="auth-checkbox-input"
                    {% if registrationForm.agreeTerms.vars.checked %}checked{% endif %}>
                <label for="{{ registrationForm.agreeTerms.vars.id }}" class="auth-checkbox-label">
                    Acepto los <a href="#" class="terminos-link" onclick="document.getElementById('modal-terminos').style.display='flex'; return false;">términos y condiciones</a>
                </label>
            </div>
            {{ form_errors(registrationForm.agreeTerms) }}
            <button type="submit" class="btn-auth-submit">Crear cuenta</button>
            {{ form_widget(registrationForm._token) }}
        {{ form_end(registrationForm, {'render_rest': false}) }}
        <p class="auth-alternate-action-text">¿Ya tienes cuenta? <a href="{{ path('app_login') }}">Inicia sesión</a></p>
    </div>
</div>

<div id="modal-terminos" class="mh-modal-overlay" style="display:none;" onclick="if(event.target===this)this.style.display='none'">
    <div class="mh-modal-card" style="max-width:600px; width:90%;">
        <div class="mh-modal-accent-bar"></div>
        <p class="mh-modal-titulo">Términos y Condiciones</p>
        <div class="mh-modal-texto" style="max-height:55vh; overflow-y:auto; text-align:left; line-height:1.7;">
            <p><strong>1. Aceptación</strong><br>
            Al registrarte en Music Hub aceptas estos términos en su totalidad. Si no estás de acuerdo, no debes usar la plataforma.</p>
            <p><strong>2. Uso de la plataforma</strong><br>
            Music Hub es una plataforma de conexión entre músicos. Te comprometes a usarla de forma respetuosa y legal, sin publicar contenido ofensivo, spam ni información falsa.</p>
            <p><strong>3. Cuenta de usuario</strong><br>
            Eres responsable de mantener la confidencialidad de tus credenciales y de toda la actividad que se realice desde tu cuenta.</p>
            <p><strong>4. Contenido</strong><br>
            Conservas la propiedad de los contenidos que publiques. Al publicarlos, nos otorgas una licencia no exclusiva para mostrarlos dentro de la plataforma.</p>
            <p><strong>5. Privacidad</strong><br>
            Tus datos personales serán tratados conforme a la normativa vigente (RGPD). Solo se utilizarán para el funcionamiento de la plataforma y no se cederán a terceros sin tu consentimiento.</p>
            <p><strong>6. Modificaciones</strong><br>
            Nos reservamos el derecho de modificar estos términos. Te notificaremos de cambios relevantes a través de la plataforma.</p>
            <p><strong>7. Contacto</strong><br>
            Para cualquier consulta sobre estos términos puedes contactarnos a través de la plataforma.</p>
        </div>
        <div class="mh-modal-acciones">
            <button type="button" class="btn-principal" onclick="document.getElementById('modal-terminos').style.display='none'">Cerrar</button>
        </div>
    </div>
</div>
{% endblock %}
