<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Music Match{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎵</text></svg>">
        {% block stylesheets %}
            <link rel="preconnect" href="https://cdn.jsdelivr.net">
            <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
            <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/vapor/bootstrap.min.css" rel="stylesheet">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
            <link rel="stylesheet" href="{{ asset('css/base.css') }}">
        {% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% endblock %}
    </head>
    <body>
        {% block liquid_background %}{% endblock %}
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('app_inicio') }}" data-text="Music Hub">Music Hub</a>
                <button class="btn-navbar-toggler navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <div class="navbar-nav ms-auto align-items-center">
                        {% if app.user %}
                            {% if app.user.musico is null %}
                                <span class="nav-link saludo-usuario">Hola, {{ app.user.email }}</span>
                            {% else %}
                                <span class="nav-link saludo-usuario">Hola, {{ app.user.musico.nombre }}</span>
                            {% endif %}
                        {% endif %}
                        <a href="{{ path('app_inicio') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_inicio' ? 'active' : '' }}">Inicio</a>
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin') }}" class="nav-link">Administrar usuarios</a>
                            {% else %}
                                {% if app.user.musico is null %}
                                    <a href="{{ path('app_musico_new') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_musico_new' ? 'active' : '' }}">Crear Perfil</a>
                                {% else %}
                                    <a href="{{ path('app_musico_show', {id: app.user.musico.id}) }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_musico_show' ? 'active' : '' }}">Mi Perfil</a>
                                {% endif %}
                                <a href="{{ path('app_musico_index') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_musico_index' ? 'active' : '' }}">Músicos</a>

                                {# ── Dropdown Bandas unificado — ver bandas + gestionar ── #}
                                <div class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Bandas
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end nav-dropdown-menu nav-dropdown-bandas">
                                        <li><a class="dropdown-item" href="{{ path('app_banda_index') }}">Ver Bandas</a></li>
                                        {% if app.user.musico is not null %}
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item" href="{{ path('app_banda_new') }}">+ Nueva Banda</a></li>
                                            {% set mis_memberships = app.user.musico.miembroBandasAceptadas %}
                                            {% if mis_memberships|length > 0 %}
                                                <li><hr class="dropdown-divider"></li>
                                                {% for mb in mis_memberships|slice(0, 3) %}
                                                    <li>
                                                        <a class="dropdown-item" href="{{ path('app_banda_show', {id: mb.banda.id}) }}">
                                                            {{ mb.banda.nombre }}
                                                            {% if mb.esAdministrador %}<small class="text-muted">(Admin)</small>{% endif %}
                                                        </a>
                                                    </li>
                                                {% endfor %}
                                            {% endif %}
                                        {% endif %}
                                    </ul>
                                </div>

                                {% if app.user.musico is not null %}

                                {# ── Mensaje y campana ── #}
                                <div class="nav-iconos-grupo">

                                    {# ── Mensajes — solo navegación ── #}
                                    <a href="{{ path('app_mensajes') }}" class="nav-link nav-chat {{ app.request.attributes.get('_route') starts with 'app_mensajes' ? 'active' : '' }}" title="Mensajes">
                                        Mensajes
                                    </a>

                                    {# ── Campana de notificaciones — invitaciones pendientes + mensajes sin leer ── #}
                                    {% set invitaciones_nav = app.user.musico.miembroBandas|filter(mb => mb.estado == 'invitado') %}
                                    {% set n_invitaciones = invitaciones_nav|length %}
                                    {% set n_mensajes = mensajes_no_leidos() %}
                                    {% set n_notificaciones = n_invitaciones + n_mensajes %}
                                    <div class="nav-item dropdown">
                                        <a class="nav-link nav-campana {{ n_notificaciones > 0 ? 'nav-campana-activa' : '' }}" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notificaciones">
                                            <i class="fa-solid fa-bell"></i>
                                            {% if n_notificaciones > 0 %}
                                                <span class="nav-campana-badge">{{ n_notificaciones }}</span>
                                            {% endif %}
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end nav-dropdown-menu nav-dropdown-notificaciones">
                                            {% if n_notificaciones == 0 %}
                                                <li><span class="dropdown-item-text nav-notif-vacia">Sin notificaciones</span></li>
                                            {% else %}
                                                {% if n_mensajes > 0 %}
                                                    <li><span class="dropdown-item-text nav-notif-titulo">Mensajes</span></li>
                                                    <li>
                                                        <a class="dropdown-item nav-notif-item" href="{{ path('app_mensajes') }}">
                                                            <i class="fa-solid fa-comment nav-notif-icono"></i>
                                                            Tienes {{ n_mensajes }} mensaje{{ n_mensajes > 1 ? 's' : '' }} sin leer
                                                        </a>
                                                    </li>
                                                    {% if n_invitaciones > 0 %}
                                                        <li><hr class="dropdown-divider"></li>
                                                    {% endif %}
                                                {% endif %}
                                                {% if n_invitaciones > 0 %}
                                                    <li><span class="dropdown-item-text nav-notif-titulo">Invitaciones pendientes</span></li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    {% for inv in invitaciones_nav %}
                                                        <li>
                                                            <a class="dropdown-item nav-notif-item" href="{{ path('app_banda_show', {id: inv.banda.id}) }}">
                                                                <i class="fa-solid fa-music nav-notif-icono"></i>
                                                                {{ inv.banda.nombre }}
                                                            </a>
                                                        </li>
                                                    {% endfor %}
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li><a class="dropdown-item nav-notif-ver-todas" href="{{ path('app_musico_show', {id: app.user.musico.id}) }}">Ver todas</a></li>
                                                {% endif %}
                                            {% endif %}
                                        </ul>
                                    </div>

                                </div>{# fin nav-iconos-grupo #}

                                {% endif %}
                            {% endif %}
                            <a href="{{ path('app_logout') }}" class="nav-link">Salir</a>
                        {% else %}
                            <a href="{{ path('app_register') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_register' ? 'active' : '' }}">Registro</a>
                            <a href="{{ path('app_login') }}" class="nav-link {{ app.request.attributes.get('_route') == 'app_login' ? 'active' : '' }}">Iniciar sesión</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>
        <div class="container-fluid px-0 px-sm-2 px-md-4">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
