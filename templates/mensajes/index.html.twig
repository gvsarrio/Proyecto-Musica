{% extends 'base.html.twig' %}

{% block title %}Mensajes — Music Hub{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/perfil.css') }}">
{% endblock %}

{% block body %}
<div class="mensajes-wrapper">

    <div class="musicos-header">
        <span class="musicos-header-bar"></span>
        <h1 class="musicos-titulo">MENSAJES</h1>
    </div>

    <div class="mensajes-lista">
        {% for conversacion in conversaciones %}

            {% if conversacion.usuarioUno == app.user %}
                {% set otroUsuario = conversacion.usuarioDos %}
            {% else %}
                {% set otroUsuario = conversacion.usuarioUno %}
            {% endif %}

            <a href="{{ path('mensaje_conversacion', {id: conversacion.id}) }}"
               class="mensajes-item {{ noLeidosPorConversacion[conversacion.id] > 0 ? 'mensajes-item-noleido' : '' }}">

                <div class="mensajes-item-avatar">
                    {% if otroUsuario.musico and otroUsuario.musico.imagenUrl %}
                        <img src="{{ asset('uploads/perfiles/' ~ otroUsuario.musico.imagenUrl) }}"
                             alt="{{ otroUsuario.musico.nombre }}">
                    {% else %}
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#9b30ff" stroke-width="1.5">
                            <path d="M9 18V5l12-2v13"/>
                            <circle cx="6" cy="18" r="3"/>
                            <circle cx="18" cy="16" r="3"/>
                        </svg>
                    {% endif %}
                </div>

                <div class="mensajes-item-body">
                    <div class="mensajes-item-top">
                        <span class="mensajes-item-nombre">
                            {{ otroUsuario.musico ? otroUsuario.musico.nombre : otroUsuario.email }}
                        </span>
                        {% if noLeidosPorConversacion[conversacion.id] > 0 %}
                            <span class="mensajes-item-badge">{{ noLeidosPorConversacion[conversacion.id] }}</span>
                        {% endif %}
                        <span class="mensajes-item-fecha">
                            {% if conversacion.fechaUltimoMensaje %}
                                {{ conversacion.fechaUltimoMensaje|date('d/m/Y H:i', 'Europe/Madrid') }}
                            {% endif %}
                        </span>
                    </div>
                    {% if conversacion.ultimoMensaje %}
                        <p class="mensajes-item-preview">
                            {% if conversacion.ultimoMensaje.remitente == app.user %}
                                <span class="mensajes-item-tu">Tú: </span>
                            {% endif %}
                            {{ conversacion.ultimoMensaje.contenido|slice(0, 60) }}{% if conversacion.ultimoMensaje.contenido|length > 60 %}...{% endif %}
                        </p>
                    {% else %}
                        <p class="mensajes-item-preview mensajes-item-preview-vacio">Sin mensajes todavía.</p>
                    {% endif %}
                </div>

            </a>

        {% else %}

            <div class="mensajes-vacio">
                <i class="fa-brands fa-weixin"></i>
                <p>No tienes conversaciones todavía.</p>
            </div>

        {% endfor %}
    </div>

</div>
{% endblock %}
