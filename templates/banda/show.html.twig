{% extends 'base.html.twig' %}

{% block title %}Banda — Music Hub{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/perfil.css') }}">
{% endblock %}

{# Fondo líquido animado #}
{% block liquid_background %}
    <div id="perfil-background"></div>
    <script>
        (function () {
            var bg = document.getElementById('perfil-background');
            var colors = [
                'rgba(175, 79, 254, 0.7)',
                'rgba(0, 242, 255, 0.7)',
                'rgba(66,0,255,0.7)',
                'rgba(222, 106, 251, 0.7)',
                'rgba(0, 255, 136, 0.7)',
                'rgba(155,48,255,0.7)'
            ];
            function createBlob() {
                var blob = document.createElement('div');
                blob.classList.add('perfil-blob');
                var size = Math.random() * 300 + 150;
                blob.style.width = size + 'px';
                blob.style.height = size + 'px';
                blob.style.left = (Math.random() * 100) + '%';
                blob.style.top = (Math.random() * 100) + '%';
                blob.style.background = colors[Math.floor(Math.random() * colors.length)];
                bg.appendChild(blob);
                animateBlob(blob);
            }
            function animateBlob(blob) {
                var speed = Math.random() * 60 + 20;
                function move() {
                    var newSize = Math.random() * 300 + 150;
                    blob.style.transition =
                        'left ' + speed + 's ease-in-out, ' +
                        'top ' + speed + 's ease-in-out, ' +
                        'width ' + (speed / 2) + 's ease-in-out, ' +
                        'height ' + (speed / 2) + 's ease-in-out';
                    blob.style.left = (Math.random() * 100) + '%';
                    blob.style.top = (Math.random() * 100) + '%';
                    blob.style.width = newSize + 'px';
                    blob.style.height = newSize + 'px';
                    setTimeout(move, speed * 1000);
                }
                move();
            }
            for (var i = 0; i < 6; i++) createBlob();

            {# Solo en dispositivos no táctiles — en móvil no hay cursor #}
            if (!('ontouchstart' in window)) {
                document.addEventListener('mousemove', function (e) {
                    var mx = e.clientX / window.innerWidth;
                    var my = e.clientY / window.innerHeight;
                    bg.querySelectorAll('.perfil-blob').forEach(function (blob, i) {
                        var dir = (i % 2 === 0) ? 1 : -1;
                        blob.style.transform = 'translate(calc(-50% + ' + ((mx - 0.5) * 30 * dir) + 'px), calc(-50% + ' + ((my - 0.5) * 30 * dir) + 'px))';
                    });
                });
            }
        })();
    </script>
{% endblock %}

{% block body %}
<div class="perfil-wrapper">
    <div class="perfil-card">
        <div class="perfil-accent-bar"></div>

        {#  Avatar / imagen de banda #}
        <div class="perfil-avatar-wrap">
            <div class="perfil-avatar">
                {% if banda.imagenUrl %}
                    <img src="{{ asset('uploads/bandas/' ~ banda.imagenUrl) }}"
                         alt="Imagen de banda">
                {% else %}
                    <svg width="45" height="45" viewBox="0 0 24 24" fill="none"
                         stroke="#00b4ff" stroke-width="1.5">
                        <path d="M9 18V5l12-2v13"/>
                        <circle cx="6" cy="18" r="3"/>
                        <circle cx="18" cy="16" r="3"/>
                    </svg>
                {% endif %}
            </div>
        </div>

        {# Título y subtítulo #}
        <h1 class="perfil-title">{{ banda.nombre }}</h1>
        <p class="perfil-subtitle">
            {% if banda.ubicacion %}{{ banda.ubicacion }}{% endif %}
            {% if banda.anyoFormacion %} · Desde {{ banda.anyoFormacion }}{% endif %}
        </p>
        <hr class="perfil-divider">

        {#  Datos  #}
        <div class="row g-4">

            {% if banda.biografia %}
            <div class="col-12">
                <p class="perfil-form-label">Biografía:</p>
                <p class="show-dato-valor">{{ banda.biografia }}</p>
            </div>
            {% endif %}

            <div class="col-md-6">
                <p class="perfil-form-label">Ubicación:</p>
                <p class="show-dato-valor">{{ banda.ubicacion }}</p>
            </div>

            <div class="col-md-6">
                <p class="perfil-form-label">Año de formación:</p>
                <p class="show-dato-valor">{{ banda.anyoFormacion }}</p>
            </div>

            {% if banda.generos %}
            <div class="col-12">
                <p class="perfil-form-label">Géneros:</p>
                <div class="musico-card-instrumentos">
                    {% for genero in banda.generos|split(',') %}
                        <span class="musico-card-instrumento-tag">{{ genero|trim }}</span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Miembros aceptados #}
            {% set miembros_aceptados = banda.miembroBandas|filter(mb => mb.estado == 'aceptado') %}
            {% if miembros_aceptados|length > 0 %}
            <div class="col-12">
                <p class="perfil-form-label">Miembros:</p>
                <div class="banda-miembros-lista">
                    {% for miembro in miembros_aceptados %}
                    <div class="banda-miembro-fila">
                        <a href="{{ path('app_musico_show', {id: miembro.musico.id}) }}" class="banda-miembro-nombre">
                            {{ miembro.musico.nombre }}
                            {% if miembro.esAdministrador %}
                                <span class="badge-admin">★</span>
                            {% endif %}
                        </a>
                        {% if miembro.musico.instrumentos|length > 0 %}
                            <div class="musico-card-instrumentos">
                                {% for instrumento in miembro.musico.instrumentos %}
                                    <span class="musico-card-instrumento-tag">{{ instrumento.nombre }}</span>
                                {% endfor %}
                            </div>
                        {% else %}
                            <span class="gestionar-fila-meta">Sin instrumentos</span>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Estado de la solicitud del usuario actual  #}
            {% if miembro_actual is not null %}
                {% if miembro_actual.estado == 'pendiente' %}
                <div class="col-12">
                    <p class="solicitud-pendiente-msg">Tu solicitud está pendiente de aprobación.</p>
                </div>
                {% elseif miembro_actual.estado == 'rechazado' %}
                <div class="col-12">
                    <p class="solicitud-rechazada-msg">Tu solicitud de unión fue rechazada.</p>
                </div>
                {% endif %}
            {% endif %}

        </div>

        {# Ventana de confirmación — Salir de la banda #}
        {% if miembro_actual is not null and miembro_actual.estado == 'aceptado' %}
            {% set total_admins_show = banda.miembroBandas|filter(mb => mb.estado == 'aceptado' and mb.esAdministrador)|length %}
            {% if not es_admin or total_admins_show > 1 %}
            <div id="modal-salir-banda" class="mh-modal-overlay" style="display:none;">
                <div class="mh-modal-card">
                    <div class="mh-modal-accent-bar"></div>
                    <p class="mh-modal-titulo">¿Salir de la banda?</p>
                    <p class="mh-modal-texto">Abandonarás {{ banda.nombre }}. Podrás solicitar unirte de nuevo en el futuro.</p>
                    <div class="mh-modal-acciones">
                        <button type="button" class="btn-eliminar" onclick="document.getElementById('form-salir-banda').submit()">Salir de la Banda</button>
                        <button type="button" class="btn-principal" onclick="document.getElementById('modal-salir-banda').style.display='none'">Cancelar</button>
                    </div>
                </div>
            </div>
            {% endif %}
        {% endif %}

        {# Botones de acción #}
        <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
            {% if es_admin %}
                <a href="{{ path('app_banda_edit', {'id': banda.id}) }}" class="btn-editar">Editar Banda</a>
                <a href="{{ path('app_banda_solicitudes', {'id': banda.id}) }}" class="btn-principal">
                    Gestionar Banda
                    {% set n_pendientes = banda.miembroBandas|filter(mb => mb.estado == 'pendiente')|length %}
                    {% if n_pendientes > 0 %}({{ n_pendientes }}){% endif %}
                </a>
            {% elseif miembro_actual is null and is_granted('IS_AUTHENTICATED_FULLY') and app.user.musico is not null %}
                <a href="{{ path('app_banda_form_solicitar_union', {id: banda.id}) }}" class="btn-confirmar">Solicitar Unirse</a>
            {% endif %}
            {% if miembro_actual is not null and miembro_actual.estado == 'aceptado' %}
                {% set total_admins_show = banda.miembroBandas|filter(mb => mb.estado == 'aceptado' and mb.esAdministrador)|length %}
                {% if not es_admin or total_admins_show > 1 %}
                    <form id="form-salir-banda" method="post" action="{{ path('app_banda_salir', {id: banda.id}) }}" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('salir_banda_' ~ banda.id) }}">
                        <button type="button" class="btn-eliminar" onclick="document.getElementById('modal-salir-banda').style.display='flex'">
                            Salir de la Banda
                        </button>
                    </form>
                {% endif %}
            {% endif %}
            <a href="{{ path('app_banda_index') }}" class="btn-confirmar">Ver Bandas</a>
        </div>

        {% if es_admin %}
        <div class="mt-3 text-center">
            {{ include('banda/_delete_form.html.twig') }}
        </div>
        {% endif %}

    </div>
</div>
{% endblock %}
