{% extends 'base.html.twig' %}

{% block title %}Banda — Music Hub{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/perfil.css') }}">
{% endblock %}

{# Fondo líquido animado #}
{% block liquid_background %}
    <div id="perfil-background"></div>
    <script>
        (function () {
            var bg = document.getElementById('perfil-background');
            var colors = [
                'rgba(175, 79, 254, 0.7)',
                'rgba(0, 242, 255, 0.7)',
                'rgba(66,0,255,0.7)',
                'rgba(222, 106, 251, 0.7)',
                'rgba(0, 255, 136, 0.7)',
                'rgba(155,48,255,0.7)'
            ];
            function createBlob() {
                var blob = document.createElement('div');
                blob.classList.add('perfil-blob');
                var size = Math.random() * 300 + 150;
                blob.style.width = size + 'px';
                blob.style.height = size + 'px';
                blob.style.left = (Math.random() * 100) + '%';
                blob.style.top = (Math.random() * 100) + '%';
                blob.style.background = colors[Math.floor(Math.random() * colors.length)];
                bg.appendChild(blob);
                animateBlob(blob);
            }
            function animateBlob(blob) {
                var speed = Math.random() * 60 + 20;
                function move() {
                    var newSize = Math.random() * 300 + 150;
                    blob.style.transition =
                        'left ' + speed + 's ease-in-out, ' +
                        'top ' + speed + 's ease-in-out, ' +
                        'width ' + (speed / 2) + 's ease-in-out, ' +
                        'height ' + (speed / 2) + 's ease-in-out';
                    blob.style.left = (Math.random() * 100) + '%';
                    blob.style.top = (Math.random() * 100) + '%';
                    blob.style.width = newSize + 'px';
                    blob.style.height = newSize + 'px';
                    setTimeout(move, speed * 1000);
                }
                move();
            }
            for (var i = 0; i < 6; i++) createBlob();
            document.addEventListener('mousemove', function (e) {
                var mx = e.clientX / window.innerWidth;
                var my = e.clientY / window.innerHeight;
                bg.querySelectorAll('.perfil-blob').forEach(function (blob, i) {
                    var dir = (i % 2 === 0) ? 1 : -1;
                    blob.style.transform = 'translate(calc(-50% + ' + ((mx - 0.5) * 30 * dir) + 'px), calc(-50% + ' + ((my - 0.5) * 30 * dir) + 'px))';
                });
            });
        })();
    </script>
{% endblock %}

{% block body %}
<div class="perfil-wrapper">
    <div class="perfil-card">
        <div class="perfil-accent-bar"></div>

        <div class="perfil-avatar-wrap">
            <div class="perfil-avatar">
                {% if banda.imagenUrl %}
                    <img src="{{ asset('uploads/bandas/' ~ banda.imagenUrl) }}"
                         alt="Imagen de banda">
                {% else %}
                    <svg width="45" height="45" viewBox="0 0 24 24" fill="none"
                         stroke="#00b4ff" stroke-width="1.5">
                        <path d="M9 18V5l12-2v13"/>
                        <circle cx="6" cy="18" r="3"/>
                        <circle cx="18" cy="16" r="3"/>
                    </svg>
                {% endif %}
            </div>
        </div>

        <h1 class="perfil-title">{{ banda.ubicacion }}</h1>
        <p class="perfil-subtitle">
            {% if banda.ubicacion %}{{ banda.ubicacion }}{% endif %}
            {% if banda.anyoFormacion %} · Desde {{ banda.anyoFormacion }}{% endif %}
        </p>
        <hr class="perfil-divider">

        <div class="row g-4">

            {% if banda.biografia %}
            <div class="col-12">
                <p class="show-dato-label" style="font-family: var(--font-body); font-size: 11px; font-weight: 700; color: var(--mh-purple-light); text-transform: uppercase; letter-spacing: 2px; margin: 0 0 4px;">Biografía:</p>
                <p style="font-family: var(--font-body); font-size: 14px; color: #e8e0ff; margin: 0;">{{ banda.biografia }}</p>
            </div>
            {% endif %}

            <div class="col-md-6">
                <p class="show-dato-label" style="font-family: var(--font-body); font-size: 11px; font-weight: 700; color: var(--mh-purple-light); text-transform: uppercase; letter-spacing: 2px; margin: 0 0 4px;">Ubicación:</p>
                <p style="font-family: var(--font-body); font-size: 14px; color: #e8e0ff; margin: 0;">{{ banda.ubicacion }}</p>
            </div>

            <div class="col-md-6">
                <p class="show-dato-label" style="font-family: var(--font-body); font-size: 11px; font-weight: 700; color: var(--mh-purple-light); text-transform: uppercase; letter-spacing: 2px; margin: 0 0 4px;">Año de formación:</p>
                <p style="font-family: var(--font-body); font-size: 14px; color: #e8e0ff; margin: 0;">{{ banda.anyoFormacion }}</p>
            </div>

            {% if banda.generos %}
            <div class="col-12">
                <p class="show-dato-label" style="font-family: var(--font-body); font-size: 11px; font-weight: 700; color: var(--mh-purple-light); text-transform: uppercase; letter-spacing: 2px; margin: 0 0 8px;">Géneros:</p>
                <div class="musico-card-instrumentos">
                    {% for genero in banda.generos|split(',') %}
                        <span class="musico-card-instrumento-tag">{{ genero|trim }}</span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if banda.miembroBandas|length > 0 %}
            <div class="col-12">
                <p class="show-dato-label" style="font-family: var(--font-body); font-size: 11px; font-weight: 700; color: var(--mh-purple-light); text-transform: uppercase; letter-spacing: 2px; margin: 0 0 8px;">Miembros:</p>
                <div class="musico-card-instrumentos">
                    {% for miembro in banda.miembroBandas %}
                        <span class="musico-card-instrumento-tag">
                            {{ miembro.musico.nombre }} · {{ miembro.rolBanda }}
                        </span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

        </div>

        <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
            <a href="{{ path('app_banda_edit', {'id': banda.id}) }}" class="btn-editar">Editar banda</a>
            <a href="{{ path('app_banda_index') }}" class="btn-confirmar">Ver bandas</a>
        </div>

        <div class="mt-3 text-center">
            {{ include('banda/_delete_form.html.twig') }}
        </div>

    </div>
</div>
{% endblock %}
