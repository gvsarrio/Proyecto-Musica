{% extends 'base.html.twig' %}

{% block title %}Banda{% endblock %}

{% block body %}
    <h1>Banda</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ banda.id }}</td>
            </tr>
            <tr>
                <th>Biografia</th>
                <td>{{ banda.biografia }}</td>
            </tr>
            <tr>
                <th>Generos</th>
                <td>{{ banda.generos }}</td>
            </tr>
            <tr>
                <th>Anyo_formacion</th>
