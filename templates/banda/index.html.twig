{# templates/banda/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Bandas — Music Hub{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/perfil.css') }}">
{% endblock %}

{# ── Fondo líquido animado ── #}
{% block liquid_background %}
    <div id="perfil-background"></div>
    <script>
        (function () {
            var bg = document.getElementById('perfil-background');
            var colors = [
                'rgba(155, 48, 255, 0.85)',
                'rgba(255, 0, 255, 0.75)',
                'rgba(0, 212, 255, 0.85)',
                'rgba(100, 0, 255, 0.8)',
                'rgba(217, 102, 255, 0.75)',
                'rgba(0, 255, 200, 0.7)'
            ];
            function createBlob() {
                var blob = document.createElement('div');
                blob.classList.add('perfil-blob');
                var size = Math.random() * 300 + 150;
                blob.style.width = size + 'px';
                blob.style.height = size + 'px';
                blob.style.left = (Math.random() * 100) + '%';
                blob.style.top = (Math.random() * 100) + '%';
                blob.style.background = colors[Math.floor(Math.random() * colors.length)];
                bg.appendChild(blob);
                animateBlob(blob);
            }
            function animateBlob(blob) {
                var speed = Math.random() * 60 + 20;
                function move() {
                    var newSize = Math.random() * 300 + 150;
                    blob.style.transition =
                        'left ' + speed + 's ease-in-out, ' +
                        'top ' + speed + 's ease-in-out, ' +
                        'width ' + (speed / 2) + 's ease-in-out, ' +
                        'height ' + (speed / 2) + 's ease-in-out';
                    blob.style.left = (Math.random() * 100) + '%';
                    blob.style.top = (Math.random() * 100) + '%';
                    blob.style.width = newSize + 'px';
                    blob.style.height = newSize + 'px';
                    setTimeout(move, speed * 1000);
                }
                move();
            }
            for (var i = 0; i < 6; i++) createBlob();

            {# Solo en dispositivos no táctiles — en móvil no hay cursor #}
            if (!('ontouchstart' in window)) {
                document.addEventListener('mousemove', function (e) {
                    var mx = e.clientX / window.innerWidth;
                    var my = e.clientY / window.innerHeight;
                    bg.querySelectorAll('.perfil-blob').forEach(function (blob, i) {
                        var dir = (i % 2 === 0) ? 1 : -1;
                        blob.style.transform = 'translate(calc(-50% + ' + ((mx - 0.5) * 30 * dir) + 'px), calc(-50% + ' + ((my - 0.5) * 30 * dir) + 'px))';
                    });
                });
            }
        })();
    </script>
{% endblock %}

{% block body %}
<div class="musicos-wrapper">

    {# ── Cabecera ── #}
    <div class="musicos-header">
        <span class="musicos-header-bar"></span>
        <h1 class="musicos-titulo">BANDAS</h1>
    </div>

    {# ── Layout filtros + lista ── #}
    <div class="musicos-layout">

    {# ── Botón mostrar filtros en móvil ── #}
    <button class="btn-filtros-movil" onclick="
        var s = document.querySelector('.musicos-filtros-sidebar');
        s.classList.toggle('sidebar-visible');
        this.textContent = s.classList.contains('sidebar-visible') ? '✕ Ocultar filtros' : '⚙ Filtros';
    ">⚙ Filtros</button>

    {# ── Sidebar de filtros ── #}
    {% include '_filtros_sidebar.html.twig' with {
        route: 'app_banda_index',
        generos: generos,
        filtros: filtros
    } only %}

    {# ── Lista de tarjetas horizontales ── #}
    <div class="musicos-lista">
        {% for banda in bandas %}
        <div class="mh-card-h">

            {# Imagen #}
            <div class="mh-card-h-img">
                {% if banda.imagenUrl %}
                    <img src="{{ asset('uploads/bandas/' ~ banda.imagenUrl) }}"
                         alt="Imagen de banda">
                {% else %}
                    <div class="mh-card-h-img-placeholder">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none"
                             stroke="#9b30ff" stroke-width="1.2">
                            <path d="M9 18V5l12-2v13"/>
                            <circle cx="6" cy="18" r="3"/>
                            <circle cx="18" cy="16" r="3"/>
                        </svg>
                    </div>
                {% endif %}
            </div>

            {# Contenido #}
            <div class="mh-card-h-body">
                <div class="mh-card-h-top">
                    <h2 class="musico-card-nombre">{{ banda.nombre }}</h2>
                    <p class="musico-card-tags">
                        {% if banda.ubicacion %}
                            <span>{{ banda.ubicacion }}</span>
                        {% endif %}
                        {% if banda.anyoFormacion %}
                            <span>Desde {{ banda.anyoFormacion }}</span>
                        {% endif %}
                        {% if banda.id in distancias|keys %}
                            <span class="musico-card-distancia-tag">{{ distancias[banda.id] }} km</span>
                        {% endif %}
                    </p>
                    {# Géneros — máximo 4 #}
                    {% if banda.generosMusicales|length > 0 %}
                    <div class="musico-card-instrumentos">
                        {% for genero in banda.generosMusicales|slice(0, 4) %}
                            <span class="musico-card-instrumento-tag">{{ genero.nombre }}</span>
                        {% endfor %}
                        {% if banda.generosMusicales|length > 4 %}
                            <span class="musico-card-instrumento-tag">+{{ banda.generosMusicales|length - 4 }}</span>
                        {% endif %}
                    </div>
                    {% endif %}
                </div>
                <div class="mh-card-h-actions">
                    <a href="{{ path('app_banda_show', {'id': banda.id}) }}" class="btn-confirmar btn-sm">Ver Banda</a>
                    <a href="#" class="btn-chat btn-sm" title="Próximamente">Chat</a>
                </div>
            </div>

        </div>
        {% else %}
        <p class="musicos-vacio">No hay bandas registradas todavía.</p>
        {% endfor %}
    </div>

    </div>{# fin musicos-layout #}

</div>

{% include '_filtros_proximidad_script.html.twig' %}
{% endblock %}
