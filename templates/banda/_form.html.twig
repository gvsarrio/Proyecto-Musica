{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}

<div class="row g-3">

    <div class="col-12">
        {{ form_label(form.nombre, 'Nombre de la banda:') }}
        {{ form_widget(form.nombre, {'attr': {'class': 'form-control', 'placeholder': 'Ej: Los Relámpagos'}}) }}
        {{ form_errors(form.nombre) }}
    </div>

    <div class="col-12">
        {{ form_label(form.biografia, 'Biografía de la banda:') }}
        {{ form_widget(form.biografia, {'attr': {'class': 'form-control', 'rows': '4', 'placeholder': 'Cuéntanos sobre el estilo e historia de la banda...'}}) }}
        {{ form_errors(form.biografia) }}
    </div>

    <div class="col-12">
        {{ form_label(form.generos_musicales, 'Géneros musicales:') }}
        <div class="perfil-instrumentos-container">
            {{ form_widget(form.generos_musicales) }}
        </div>
        <small style="color: var(--mh-text-muted);">Selecciona todos los que apliquen</small>
        {{ form_errors(form.generos_musicales) }}
    </div>

    <div class="col-md-6">
        {{ form_label(form.anyo_formacion, 'Año de formación:') }}
        {{ form_widget(form.anyo_formacion, {'attr': {'class': 'form-control', 'placeholder': 'Ej: 2010'}}) }}
        {{ form_errors(form.anyo_formacion) }}
    </div>

    <div class="col-md-6"
        data-controller="google-places-autocomplete"
        data-google-places-autocomplete-api-key-value="{{ google_places_api_key }}">
        {{ form_label(form.ubicacion, 'Ubicación:') }}
        {{ form_widget(form.ubicacion, {'attr': {'class': 'form-control', 'placeholder': 'Ej: Murcia, España'}}) }}
        {{ form_errors(form.ubicacion) }}
        {{ form_widget(form.latitud, {'attr': {'data-google-places-autocomplete-target': 'lat'}}) }}
        {{ form_widget(form.longitud, {'attr': {'data-google-places-autocomplete-target': 'lng'}}) }}
    </div>

    <div class="col-12">
        {{ form_label(form.imagen_url, 'Imagen de la banda:') }}
        {{ form_widget(form.imagen_url, {'attr': {'class': 'form-control'}}) }}
        <small style="color: var(--mh-text-muted);">Formatos permitidos: JPG, PNG o WEBP (Máx. 2MB)</small>
        {{ form_errors(form.imagen_url) }}
    </div>

</div>

<div class="d-flex justify-content-center mt-4">
<button type="submit" class="btn-principal">{{ button_label|default('Guardar') }}</button>
</div>

{{ form_end(form) }}

