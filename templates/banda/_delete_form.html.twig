<form method="post" action="{{ path('app_banda_delete', {'id': banda.id}) }}" onsubmit="return confirm('¿Estás seguro de que quieres eliminar este elemento?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ banda.id) }}">
    <button class="btn-eliminar">Eliminar Banda</button>
</form>
