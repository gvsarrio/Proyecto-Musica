{# Ventana de confirmación — Eliminar banda #}
{% set otros_miembros = banda.miembroBandas|filter(mb => mb.estado == 'aceptado')|length > 1 %}

{# Modal bloqueante: hay otros miembros además del admin #}
<div id="modal-eliminar-banda-bloqueado" class="mh-modal-overlay" style="display:none;">
    <div class="mh-modal-card">
        <div class="mh-modal-accent-bar"></div>
        <p class="mh-modal-titulo">No se puede eliminar</p>
        <p class="mh-modal-texto">Debes eliminar a todos los miembros de la banda antes de poder borrarla.</p>
        <div class="mh-modal-acciones">
            <button type="button" class="btn-principal" onclick="document.getElementById('modal-eliminar-banda-bloqueado').style.display='none'">Aceptar</button>
        </div>
    </div>
</div>

{# Modal de confirmación: solo queda el admin #}
<div id="modal-eliminar-banda" class="mh-modal-overlay" style="display:none;">
    <div class="mh-modal-card">
        <div class="mh-modal-accent-bar"></div>
        <p class="mh-modal-titulo">¿Eliminar banda?</p>
        <p class="mh-modal-texto">Esta acción es irreversible. La banda será eliminada permanentemente.</p>
        <div class="mh-modal-acciones">
            <button type="button" class="btn-eliminar" onclick="document.getElementById('form-eliminar-banda').submit()">Eliminar Banda</button>
            <button type="button" class="btn-principal" onclick="document.getElementById('modal-eliminar-banda').style.display='none'">Cancelar</button>
        </div>
    </div>
</div>

<form id="form-eliminar-banda" method="post" action="{{ path('app_banda_delete', {'id': banda.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ banda.id) }}">
    <button type="button" class="btn-eliminar" onclick="document.getElementById('{{ otros_miembros ? 'modal-eliminar-banda-bloqueado' : 'modal-eliminar-banda' }}').style.display='flex'">
        Eliminar
    </button>
</form>
